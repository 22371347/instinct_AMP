# ============================================================
# 版本控制忽略规则
# 原则：只跟踪「我们自己的代码/文档/配置」，不跟踪可复现的上游克隆与版权材料
# ============================================================

# ---- 上游克隆仓库（体积大、可随时重新 clone）----
llp_reference/
instinct/repos/

# ---- 论文原文与提取文本（版权，不入库）----
*.pdf
papers_txt/*.txt

# ---- 本地生成 / 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/
.ipynb_checkpoints/

# ---- 训练输出（云端训练，本地不入库）----
instinct_xu/logs/
logs/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*~
.DS_Store
Thumbs.db

# ---- 环境凭据（绝不入库）----
.env
.env.*
*.env
!*.env.example

# ---- 训练曲线图（由 tools/refresh_plots.sh 自动生成，会频繁变动，不入库）----
instinct/plots/

# ---- MuJoCo 回放产物（录像/onnx/归一化，体积大且可重新生成）----
instinct/eval/

# ---- 外部产物 / 生成物（2026-10-08 清理前快照时排除）----
